# SkillWiki 环境变量示例

# LLM 配置
# Set LLM_API_KEY in your shell or a Git-ignored local environment file.
LLM_API_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# LLM_API_KEY=replace-with-your-own-key
# Keep generation controls explicit; tune only after the baseline run is frozen.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=30
LLM_RETRY_COUNT=0

# 数据库配置
DB_POSTGRES_HOST=localhost
DB_POSTGRES_PORT=5432
DB_POSTGRES_DATABASE=skillwiki
DB_POSTGRES_USER=postgres
DB_POSTGRES_PASSWORD=your_password_here

DB_NEO4J_URI=bolt://localhost:7687
DB_NEO4J_USER=neo4j
DB_NEO4J_PASSWORD=your_password_here

DB_MONGODB_URI=mongodb://localhost:27017
DB_MONGODB_DATABASE=skillwiki

DB_REDIS_HOST=localhost
DB_REDIS_PORT=6379
DB_REDIS_DB=0
DB_REDIS_PASSWORD=

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/skillwiki.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=10

# 应用配置
DEBUG=false
ENVIRONMENT=development
