  "implementation": {
    "language": "prompt",
    "code": null,
    "prompt_template": "Given a Pet object and OAuth2 access token, validate the Pet against the Petstore Pet schema (required name and photoUrls; optional id, category, tags, status enum). Then construct a POST request to http://petstore.swagger.io/v2/pet with Content-Type application/json or application/xml, Authorization Bearer token, and the serialized Pet body. Return the request details and any validation errors.",
